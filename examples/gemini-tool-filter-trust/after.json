{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@github/github-mcp-server"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_TOKEN"
      },
      "includeTools": [
        "get_issue",
        "get_pull_request",
        "search_code",
        "merge_pull_request",
        "create_release"
      ],
      "trust": true
    }
  }
}
